local function resetAutoAcceptTradeTimers()
    autoAcceptWaitingForWinSince = 0
    autoAcceptNextQuickChatAt = 0
    autoAcceptDeclineSentForCurrentTrade = false
    autoAcceptWasTradeOpen = false
    autoAcceptAlreadyAcceptedCurrentWin = false
    autoAcceptLastTradeSignature = ""
    autoAcceptAcceptedTradeSignature = ""
end

local function scheduleNextAutoAcceptQuickChat(now)
    autoAcceptNextQuickChatAt = now + math.random(AUTO_ACCEPT_QUICK_CHAT_MIN_DELAY, AUTO_ACCEPT_QUICK_CHAT_MAX_DELAY)
end

local function startAutoAccept()
    if autoAcceptLoopRunning then return end

    autoAcceptLoopRunning = true

    task.spawn(function()
        resetAutoAcceptTradeTimers()

        while autoAccept do
            if not tradeHelperEnabled then
                autoAccept = false
                notify("Auto Accept", "This will not work unless activate trade helper is on it's needed to check values", 4)
                break
            end

            local now = os.clock()
            local currentTradeSignature = getTradeWindowSignature()
            local tradeOpen = currentTradeSignature ~= "no_trade_gui"

            if not tradeOpen then
                resetAutoAcceptTradeTimers()
                task.wait(0.5)
                continue
            end

            if tradeOpen and not autoAcceptWasTradeOpen then
                autoAcceptWasTradeOpen = true
                autoAcceptWaitingForWinSince = now
                scheduleNextAutoAcceptQuickChat(now)
                autoAcceptDeclineSentForCurrentTrade = false
                autoAcceptAlreadyAcceptedCurrentWin = false
                autoAcceptLastTradeSignature = ""
                autoAcceptAcceptedTradeSignature = ""
                print("[Auto Accept] Trade detected. Waiting up to " .. tostring(AUTO_ACCEPT_DECLINE_AFTER_SECONDS) .. " seconds for WIN.")
            end

            local result = getTradeResult()

            if result == "WIN" then
                autoAcceptWaitingForWinSince = 0
                autoAcceptNextQuickChatAt = 0
                autoAcceptDeclineSentForCurrentTrade = false

                local tradeSignature = currentTradeSignature

                if tradeSignature ~= autoAcceptLastTradeSignature then
                    autoAcceptLastTradeSignature = tradeSignature
                    autoAcceptAlreadyAcceptedCurrentWin = false
                end

                if now - lastAutoAcceptAt >= AUTO_ACCEPT_RETRY_DELAY then
                    lastAutoAcceptAt = now

                    if acceptNegotiationOnce() then
                        autoAcceptAlreadyAcceptedCurrentWin = true
                        autoAcceptAcceptedTradeSignature = tradeSignature
                    end
                end
            else
                autoAcceptAlreadyAcceptedCurrentWin = false
                autoAcceptLastTradeSignature = ""
                autoAcceptAcceptedTradeSignature = ""

                if not autoAcceptDeclineSentForCurrentTrade then
                    if autoAcceptWaitingForWinSince <= 0 then
                        autoAcceptWaitingForWinSince = now
                        scheduleNextAutoAcceptQuickChat(now)
                    end

                    if autoAcceptNextQuickChatAt > 0 and now >= autoAcceptNextQuickChatAt then
                        sendAutoAcceptQuickChat()
                        scheduleNextAutoAcceptQuickChat(now)
                    end

                    if now - autoAcceptWaitingForWinSince >= AUTO_ACCEPT_DECLINE_AFTER_SECONDS then
                        autoAcceptDeclineSentForCurrentTrade = true
                        declineTradeOnce()
                        notify("Auto Accept", "No WIN detected after 90 seconds. Declined trade.", 4)
                    end
                end
            end

            task.wait(0.5)
        end

        resetAutoAcceptTradeTimers()
        autoAcceptLoopRunning = false
    end)
end

local function startAutoTrade()
    if autoTradeLoopRunning then return end

    autoTradeLoopRunning = true

    task.spawn(function()
        while autoTrade do
            if not tradeHelperEnabled then
                autoTrade = false
                notify("Auto Trade", "This will not work unless activate trade helper is on it's needed to check values", 4)
                break
            end

            local result = getTradeResult()

            if result == "WIN" then
                print("[Auto Trade]: Trade is good. WIN detected.")
            elseif result == "FAIR" then
                print("[Auto Trade]: Trade is fair. FAIR detected.")
            elseif result == "LOSE" then
                print("[Auto Trade]: Trade is bad. LOSE detected.")
            else
                print("[Auto Trade]: No WIN / FAIR / LOSE result detected.")
            end

            local waited = 0
            while autoTrade and waited < 10 do
                task.wait(1)
                waited += 1
            end
        end

        autoTradeLoopRunning = false
    end)
end

local function cleanPetName(name)
    name = tostring(name or "")
    name = name:gsub("<[^>]->", "")
    name = name:gsub("%s*x%s*%d+%s*$", "")
    name = name:gsub("^%s+", "")
    name = name:gsub("%s+$", "")

    return name
end

local function getInstanceByPath(path)
    local current = game

    for part in string.gmatch(path, "[^%.]+") do
        current = current:FindFirstChild(part)

        if not current then
            return nil
        end
    end

    return current
end

local function safeRequirePath(path)
    local moduleScript = getInstanceByPath(path)

    if not moduleScript or not moduleScript:IsA("ModuleScript") then
        return nil
    end

    local ok, value = pcall(function()
        return require(moduleScript)
    end)

    if ok then
        return value
    end

    warn("[Trade Pets]: Failed to require " .. tostring(path) .. ":", value)
    return nil
end

local function getKindInfo(kind, kindDb)
    if type(kind) ~= "string" or type(kindDb) ~= "table" then
        return nil
    end

    local data = kindDb[kind]

    if type(data) ~= "table" then
        return nil
    end

    return {
        kind = kind,
        name = cleanPetName(data.name or data.Name or data.display_name or data.DisplayName or data.displayName or kind),
        rarity = tostring(data.rarity or data.Rarity or "unknown")
    }
end

local function findPetKind(value, kindDb, depth, seen)
    if depth > 5 then
        return nil
    end

    if type(value) == "string" then
        if getKindInfo(value, kindDb) then
            return value
        end

        return nil
    end

    if type(value) ~= "table" then
        return nil
    end

    if seen[value] then
        return nil
    end

    seen[value] = true

    local fields = {
        "kind",
        "Kind",
        "id",
        "Id",
        "item_id",
        "itemId",
        "item_kind",
        "itemKind",
        "type",
        "Type"
    }

    for _, field in ipairs(fields) do
        local possibleKind = value[field]

        if type(possibleKind) == "string" and getKindInfo(possibleKind, kindDb) then
            return possibleKind
        end
    end

    for _, child in pairs(value) do
        local found = findPetKind(child, kindDb, depth + 1, seen)

        if found then
            return found
        end
    end

    return nil
end

local function getInventoryPetData()
    local petDataByName = {}

    local kindDb = safeRequirePath("ReplicatedStorage.ClientDB.Inventory.KindDB")
    local clientData = safeRequirePath("ReplicatedStorage.ClientModules.Core.ClientData")

    if type(kindDb) ~= "table" then
        warn("[Trade Pets]: KindDB did not load.")
        return petDataByName
    end

    if type(clientData) ~= "table" or type(clientData.get) ~= "function" then
        warn("[Trade Pets]: ClientData did not load.")
        return petDataByName
    end

    local ok, inventory = pcall(function()
        return clientData.get("inventory")
    end)

    if not ok or type(inventory) ~= "table" then
        warn("[Trade Pets]: ClientData.get('inventory') did not return inventory data.")
        return petDataByName
    end

    local pets = inventory.pets

    if type(pets) ~= "table" then
        warn("[Trade Pets]: inventory.pets was not found.")
        return petDataByName
    end

    for uniqueId, petEntry in pairs(pets) do
        local kind = findPetKind(petEntry, kindDb, 0, {})
        local info = getKindInfo(kind, kindDb)

        if info and info.name ~= "" then
            petDataByName[info.name] = petDataByName[info.name] or {
                name = info.name,
                kind = info.kind,
                rarity = info.rarity,
                count = 0,
                ids = {}
            }

            petDataByName[info.name].count += 1
            table.insert(petDataByName[info.name].ids, tostring(uniqueId))
        end
    end

    return petDataByName
end

local function rebuildTradePetOptions()
    local ownedPetData = getInventoryPetData()

    tradePetCounts = {}
    tradePetOptionToName = {}
    tradePetOptionToData = {}

    local petList = {}

    for _, petData in pairs(ownedPetData) do
        table.insert(petList, petData)
    end

    table.sort(petList, function(a, b)
        return tostring(a.name):lower() < tostring(b.name):lower()
    end)

    local options = {}

    for _, petData in ipairs(petList) do
        local optionName = petData.name .. " x" .. tostring(petData.count)

        tradePetCounts[petData.name] = petData.count
        tradePetOptionToName[optionName] = petData.name
        tradePetOptionToData[optionName] = petData
        table.insert(options, optionName)
    end

    if #options == 0 then
        table.insert(options, "No owned pets found - press Refresh Pet List")
    end

    print("[Trade Pets]: Found " .. tostring(#petList) .. " owned pet type(s).")

    return options
end

local function normalizeSelectedTradePetOptions(option)
    local normalized = {}
    local used = {}

    local function addOption(value)
        local optionText = tostring(value or "")

        if optionText ~= "" and tradePetOptionToData[optionText] and not used[optionText] then
            used[optionText] = true
            table.insert(normalized, optionText)
        end
    end

    if type(option) == "table" then
        for _, value in ipairs(option) do
            addOption(value)
        end

        if #normalized == 0 then
            for key, value in pairs(option) do
                if type(key) == "string" and value == true then
                    addOption(key)
                elseif type(value) == "string" then
                    addOption(value)
                end
            end
        end
    else
        addOption(option)
    end

    return normalized
end

local function getCurrentSelectedTradePetDataList()
    local list = {}

    for _, optionText in ipairs(selectedTradePetOptions) do
        local data = tradePetOptionToData[optionText]

        if data then
            table.insert(list, data)
        end
    end

    return list
end

local function getSelectedTradePetUniqueIds()
    local selectedUniqueIds = {}
    local selectedPetItems = {}
    local quantityPerPet = tonumber(selectedTradePetQuantity) or 1

    if quantityPerPet < 1 then
        quantityPerPet = 1
    end

    if quantityPerPet > MAX_TRADE_ITEMS_TO_ADD then
        quantityPerPet = MAX_TRADE_ITEMS_TO_ADD
    end

    for _, data in ipairs(getCurrentSelectedTradePetDataList()) do
        local ids = data.ids or {}
        local chosenForThisPet = {}
        local maxForThisPet = quantityPerPet

        if maxForThisPet > #ids then
            maxForThisPet = #ids
        end

        for i = 1, maxForThisPet do
            if ids[i] and #selectedUniqueIds < MAX_TRADE_ITEMS_TO_ADD then
                table.insert(selectedUniqueIds, ids[i])
                table.insert(chosenForThisPet, ids[i])
            end
        end

        table.insert(selectedPetItems, {
            PetName = data.name or "",
            DisplayName = (data.name or "") .. " x" .. tostring(data.count or 0),
            Kind = data.kind or "",
            Rarity = data.rarity or "",
            Quantity = #chosenForThisPet,
            MaxQuantity = tonumber(data.count) or #ids,
            UniqueIds = ids,
            SelectedUniqueIds = chosenForThisPet
        })

        if #selectedUniqueIds >= MAX_TRADE_ITEMS_TO_ADD then
            break
        end
    end

    return selectedUniqueIds, selectedPetItems
end

