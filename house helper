local function setSelectedTradePetFromOption(option)
    selectedTradePetOptions = normalizeSelectedTradePetOptions(option)

    local firstOption = selectedTradePetOptions[1]
    selectedTradePetDisplay = tostring(firstOption or "")

    local firstData = firstOption and tradePetOptionToData[firstOption] or nil

    if firstData then
        selectedTradePet = firstData.name or ""
        selectedTradePetKind = firstData.kind or ""
        selectedTradePetRarity = firstData.rarity or ""
        selectedTradePetIds = firstData.ids or {}
        selectedTradePetMaxQuantity = tonumber(firstData.count) or 1
    else
        selectedTradePet = ""
        selectedTradePetKind = ""
        selectedTradePetRarity = ""
        selectedTradePetIds = {}
        selectedTradePetMaxQuantity = 1
    end

    for _, data in ipairs(getCurrentSelectedTradePetDataList()) do
        local count = tonumber(data.count) or 1

        if count > selectedTradePetMaxQuantity then
            selectedTradePetMaxQuantity = count
        end
    end

    local maxAllowed = selectedTradePetMaxQuantity

    if maxAllowed < 1 then
        maxAllowed = 1
    end

    if selectedTradePetQuantity < 1 then
        selectedTradePetQuantity = 1
    end

    if selectedTradePetQuantity > maxAllowed then
        selectedTradePetQuantity = maxAllowed
    end

    updateTradePetSelectionExport()

    if #selectedTradePetOptions > 0 then
        print("[Trade Pets]: Selected " .. tostring(#selectedTradePetOptions) .. " pet type(s), quantity each: " .. tostring(selectedTradePetQuantity))
    else
        print("[Trade Pets]: No pet selected.")
    end
end

