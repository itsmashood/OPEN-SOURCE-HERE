TradeMessageTab:CreateToggle({
    Name = "Start Trade Auto Message",
    CurrentValue = false,
    Callback = function(value)
        tradeMessageSending = value

        if tradeMessageSending then
            task.spawn(function()
                while tradeMessageSending do
                    for i = 1, tradeActiveMessageCount do
                        if not tradeMessageSending then break end

                        waitWhileInTrade(function()
                            return tradeMessageSending
                        end)

                        if not tradeMessageSending then break end

                        local msg = TradeMessages[i]

                        if msg and msg ~= "" then
                            sendChatMessage(msg)
                            waitMessengerInterval(tradeMessageInterval, function()
                                return tradeMessageSending
                            end)
                        end
                    end
                    waitMessengerInterval(0.1, function()
                        return tradeMessageSending
                    end)
                end
            end)
        end
    end
})

