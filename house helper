local function startHouseAutoAcceptConfirmTrade()
    if houseAutoAcceptConfirmTradeLoopRunning then return end

    houseAutoAcceptConfirmTradeLoopRunning = true

    task.spawn(function()
        while houseAutoAcceptConfirmTrade do
            local currentTradeSignature = getTradeWindowSignature()
            local tradeOpen = currentTradeSignature ~= "no_trade_gui"

            if not tradeOpen then
                houseAutoConfirmLastTradeSignature = ""
                houseAutoConfirmLastAttemptAt = 0
                houseAutoConfirmInProgress = false
                task.wait(0.5)
                continue
            end

            local met, theirValue, target = houseValueTargetIsMet()
            local now = os.clock()

            if met then
                if now - houseAutoAcceptLastAt >= HOUSE_AUTO_ACCEPT_RETRY_DELAY then
                    houseAutoAcceptLastAt = now
                    acceptHouseTradeOnce(theirValue, target)
                end

                if not houseAutoConfirmInProgress then
                    if currentTradeSignature ~= houseAutoConfirmLastTradeSignature or now - houseAutoConfirmLastAttemptAt >= HOUSE_AUTO_CONFIRM_RETRY_DELAY then
                        houseAutoConfirmLastTradeSignature = currentTradeSignature
                        houseAutoConfirmLastAttemptAt = now
                        houseAutoConfirmInProgress = true

                        task.spawn(function()
                            for attempt = 1, 3 do
                                if not houseAutoAcceptConfirmTrade then
                                    break
                                end

                                local stillMet, latestTheirValue, latestTarget = houseValueTargetIsMet()

                                if not stillMet then
                                    warn("[House Auto Accept + Confirm] Confirm stopped because their side value no longer meets target.")
                                    break
                                end

                                confirmHouseTradeOnce(attempt, latestTheirValue, latestTarget)

                                if attempt < 3 then
                                    task.wait(1)
                                end
                            end

                            houseAutoConfirmInProgress = false
                        end)
                    end
                end
            else
                houseAutoConfirmLastTradeSignature = ""
            end

            task.wait(0.5)
        end

        houseAutoConfirmInProgress = false
        houseAutoConfirmLastTradeSignature = ""
        houseAutoConfirmLastAttemptAt = 0
        houseAutoAcceptLastAt = 0
        houseAutoAcceptConfirmTradeLoopRunning = false
    end)
end
