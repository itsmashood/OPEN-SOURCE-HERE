local function isGuiObjectActuallyVisible(guiObject)
    local current = guiObject

    while current do
        if current:IsA("GuiObject") and current.Visible == false then
            return false
        end

        if current:IsA("LayerCollector") and current.Enabled == false then
            return false
        end

        current = current.Parent
    end

    if guiObject:IsA("GuiObject") then
        if guiObject.AbsoluteSize.X <= 0 or guiObject.AbsoluteSize.Y <= 0 then
            return false
        end

        if guiObject:IsA("TextLabel") or guiObject:IsA("TextButton") or guiObject:IsA("TextBox") then
            if guiObject.TextTransparency >= 1 then
                return false
            end
        end
    end

    return true
end

local function normalizeTradeResultText(text)
    return tostring(text or "")
        :upper()
        :gsub("<[^>]->", "")
        :gsub("%s+", "")
        :gsub("[^%a]", "")
end

local function getTradeResult()
    local foundWin = false
    local foundFair = false

    for _, root in ipairs(getGuiSearchRoots()) do
        for _, descendant in ipairs(root:GetDescendants()) do
            if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
                if isGuiObjectActuallyVisible(descendant) then
                    local cleanText = normalizeTradeResultText(descendant.Text)

                    if cleanText == "LOSE" or cleanText == "LOSS" then
                        return "LOSE"
                    elseif cleanText == "FAIR" then
                        foundFair = true
                    elseif cleanText == "WIN" then
                        foundWin = true
                    end
                end
            end
        end
    end

    if foundWin then
        return "WIN"
    end

    if foundFair then
        return "FAIR"
    end

    return nil
end

local function getTradeWindowSignature()
    local parts = {}
    local tradeRoots = {}

    for _, root in ipairs(getGuiSearchRoots()) do
        for _, child in ipairs(root:GetChildren()) do
            local childName = tostring(child.Name):lower()

            if childName:find("trade") then
                table.insert(tradeRoots, child)
            end
        end
    end

    if #tradeRoots == 0 then
        return "no_trade_gui"
    end

    local added = 0

    local function addPart(value)
        added += 1

        if added <= 700 then
            table.insert(parts, tostring(value))
        end
    end

    for _, tradeRoot in ipairs(tradeRoots) do
        if tradeRoot and tradeRoot.Parent then
            addPart(tradeRoot:GetFullName())

            for _, descendant in ipairs(tradeRoot:GetDescendants()) do
                if isGuiObjectActuallyVisible(descendant) then
                    if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
                        addPart(descendant:GetFullName() .. "=" .. tostring(descendant.Text))
                    elseif descendant:IsA("ImageLabel") or descendant:IsA("ImageButton") then
                        addPart(descendant:GetFullName() .. "=" .. tostring(descendant.Image))
                    end
                end
            end
        end
    end

    table.sort(parts)

    return table.concat(parts, "||")
end

local function getTradeApiRemote(remoteName)
    local api = ReplicatedStorage:FindFirstChild("API")

    if not api then
        warn("[Auto Accept] API folder not found")
        return nil
    end

    local remote = api:FindFirstChild(remoteName)

    if not remote then
        warn("[Auto Accept] " .. tostring(remoteName) .. " remote not found")
        return nil
    end

    if not remote:IsA("RemoteFunction") and not remote:IsA("RemoteEvent") then
        warn("[Auto Accept] " .. tostring(remoteName) .. " is not a remote. Class:", remote.ClassName)
        return nil
    end

    return remote
end

local function callTradeApiRemote(remoteName, ...)
    local remote = getTradeApiRemote(remoteName)

    if not remote then
        return false
    end

    local args = {...}

    local ok, result = pcall(function()
        if remote:IsA("RemoteFunction") then
            return remote:InvokeServer(unpack(args))
        elseif remote:IsA("RemoteEvent") then
            remote:FireServer(unpack(args))
            return "sent"
        end
    end)

    if not ok then
        warn("[Auto Accept] " .. tostring(remoteName) .. " failed:", result)
        return false
    end

    return true, result
end

