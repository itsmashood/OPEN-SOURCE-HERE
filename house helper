                break
            end

            local result = getTradeResult()

            if result == "WIN" then
                print("[Auto Trade]: Trade is good. WIN detected.")
            elseif result == "FAIR" then
                print("[Auto Trade]: Trade is fair. FAIR detected.")
            elseif result == "LOSE" then
                print("[Auto Trade]: Trade is bad. LOSE detected.")
            else
                print("[Auto Trade]: No WIN / FAIR / LOSE result detected.")
            end

            local waited = 0
            while autoTrade and waited < 10 do
                task.wait(1)
                waited += 1
            end
        end

        autoTradeLoopRunning = false
    end)
end

local function cleanPetName(name)
    name = tostring(name or "")
    name = name:gsub("<[^>]->", "")
    name = name:gsub("%s*x%s*%d+%s*$", "")
    name = name:gsub("^%s+", "")
    name = name:gsub("%s+$", "")

    return name
end

local function getInstanceByPath(path)
    local current = game

    for part in string.gmatch(path, "[^%.]+") do
        current = current:FindFirstChild(part)

        if not current then
            return nil
        end
    end

    return current
end

local function safeRequirePath(path)
    local moduleScript = getInstanceByPath(path)

    if not moduleScript or not moduleScript:IsA("ModuleScript") then
        return nil
    end

    local ok, value = pcall(function()
        return require(moduleScript)
    end)

    if ok then
        return value
    end

    warn("[Trade Pets]: Failed to require " .. tostring(path) .. ":", value)
    return nil
end

local function getKindInfo(kind, kindDb)
    if type(kind) ~= "string" or type(kindDb) ~= "table" then
        return nil
    end

    local data = kindDb[kind]

    if type(data) ~= "table" then
        return nil
    end

    return {
        kind = kind,
        name = cleanPetName(data.name or data.Name or data.display_name or data.DisplayName or data.displayName or kind),
        rarity = tostring(data.rarity or data.Rarity or "unknown")
    }
end

local function findPetKind(value, kindDb, depth, seen)
    if depth > 5 then
        return nil
    end

    if type(value) == "string" then
        if getKindInfo(value, kindDb) then
            return value
        end

        return nil
    end

    if type(value) ~= "table" then
        return nil
    end

    if seen[value] then
        return nil
    end

    seen[value] = true

    local fields = {
        "kind",
        "Kind",
        "id",
        "Id",
        "item_id",
        "itemId",
        "item_kind",
        "itemKind",
        "type",
        "Type"
    }

    for _, field in ipairs(fields) do
        local possibleKind = value[field]

        if type(possibleKind) == "string" and getKindInfo(possibleKind, kindDb) then
            return possibleKind
        end
    end

    for _, child in pairs(value) do
        local found = findPetKind(child, kindDb, depth + 1, seen)

        if found then
            return found
        end
    end

    return nil
end

local function isTruthyPetProperty(value)
    if value == true then
        return true
    end

    if type(value) == "number" then
        return value ~= 0
    end

    if type(value) == "string" then
        local lowered = value:lower()

        return lowered == "true" or lowered == "yes" or lowered == "1" or lowered == "on"
    end

    return false
end

local function normalizePetPropertyKey(key)
    return tostring(key or ""):lower():gsub("[^%w]", "")
end

local function hasPetPropertyFlag(value, names, depth, seen)
    if depth > 6 then
        return false
    end

    if type(value) ~= "table" then
        return false
    end

    if seen[value] then
        return false
    end

    seen[value] = true

    local normalizedNames = {}

    for _, name in ipairs(names) do
        normalizedNames[normalizePetPropertyKey(name)] = true
    end

    for key, child in pairs(value) do
        local keyText = normalizePetPropertyKey(key)

        if normalizedNames[keyText] and isTruthyPetProperty(child) then
            return true
        end

        if type(child) == "string" and normalizedNames[normalizePetPropertyKey(child)] then
            return true
        end

        if type(child) == "table" and hasPetPropertyFlag(child, names, depth + 1, seen) then
            return true
        end
    end

    return false
end

local function getPetVariantData(petEntry)
    local mega = hasPetPropertyFlag(petEntry, {
        "mega_neon",
        "megaNeon",
        "mega_neonable",
        "mega"
    }, 0, {})

    local neon = hasPetPropertyFlag(petEntry, {
        "neon",
        "neonable",
        "is_neon",
        "isNeon"
    }, 0, {})

    local fly = hasPetPropertyFlag(petEntry, {
        "flyable",
        "is_flyable",
        "isFlyable",
        "can_fly",
        "canFly",
        "fly"
    }, 0, {})

    local ride = hasPetPropertyFlag(petEntry, {
        "rideable",
        "is_rideable",
        "isRideable",
        "can_ride",
        "canRide",
        "ride"
    }, 0, {})

    if mega then
        neon = false
    end

    local parts = {}
    local shortParts = {}

    if mega then
        table.insert(parts, "Mega")
        table.insert(shortParts, "mega")
    elseif neon then
        table.insert(parts, "Neon")
        table.insert(shortParts, "neon")
    else
        table.insert(parts, "Normal")
        table.insert(shortParts, "normal")
    end

    if fly then
        table.insert(parts, "Fly")
        table.insert(shortParts, "fly")
    end

    if ride then
        table.insert(parts, "Ride")
        table.insert(shortParts, "ride")
    end

    return {
        label = table.concat(parts, " "),
        key = table.concat(shortParts, "_"),
        isMega = mega,
        isNeon = neon,
        isFly = fly,
        isRide = ride
    }
end

local function makePetVariantDisplayName(baseName, variant)
    baseName = cleanPetName(baseName)

    if type(variant) ~= "table" or variant.label == "" then
        return baseName
    end

    return variant.label .. " " .. baseName
end

local function getInventoryPetData()
    local petDataByName = {}

    local kindDb = safeRequirePath("ReplicatedStorage.ClientDB.Inventory.KindDB")
    local clientData = safeRequirePath("ReplicatedStorage.ClientModules.Core.ClientData")

    if type(kindDb) ~= "table" then
        warn("[Trade Pets]: KindDB did not load.")
        return petDataByName
    end

    if type(clientData) ~= "table" or type(clientData.get) ~= "function" then
        warn("[Trade Pets]: ClientData did not load.")
        return petDataByName
    end

    local ok, inventory = pcall(function()
        return clientData.get("inventory")
    end)

    if not ok or type(inventory) ~= "table" then
        warn("[Trade Pets]: ClientData.get('inventory') did not return inventory data.")
        return petDataByName
    end

    local pets = inventory.pets

    if type(pets) ~= "table" then
        warn("[Trade Pets]: inventory.pets was not found.")
        return petDataByName
    end

    for uniqueId, petEntry in pairs(pets) do
        local kind = findPetKind(petEntry, kindDb, 0, {})
        local info = getKindInfo(kind, kindDb)

        if info and info.name ~= "" then
            local variant = getPetVariantData(petEntry)
            local displayName = makePetVariantDisplayName(info.name, variant)
            local groupKey = tostring(info.kind) .. "|" .. tostring(variant.key)

            petDataByName[groupKey] = petDataByName[groupKey] or {
                name = info.name,
                displayName = displayName,
                variant = variant,
                variantLabel = variant.label,
                variantKey = variant.key,
                isMega = variant.isMega,
                isNeon = variant.isNeon,
                isFly = variant.isFly,
                isRide = variant.isRide,
                kind = info.kind,
                rarity = info.rarity,
                count = 0,
                ids = {}
            }

            petDataByName[groupKey].count += 1
            table.insert(petDataByName[groupKey].ids, tostring(uniqueId))
        end
    end

    return petDataByName
end

local function rebuildTradePetOptions()
    local ownedPetData = getInventoryPetData()

    tradePetCounts = {}
    tradePetOptionToName = {}
    tradePetOptionToData = {}

    local petList = {}

    for _, petData in pairs(ownedPetData) do
        table.insert(petList, petData)
    end

    table.sort(petList, function(a, b)
        local aName = tostring(a.name or ""):lower()
        local bName = tostring(b.name or ""):lower()

        if aName == bName then
            return tostring(a.variantLabel or ""):lower() < tostring(b.variantLabel or ""):lower()
        end

        return aName < bName
    end)

    local options = {}

    for _, petData in ipairs(petList) do
        local displayName = petData.displayName or petData.name or "Unknown Pet"
        local optionName = displayName .. " x" .. tostring(petData.count)

        tradePetCounts[displayName] = petData.count
        tradePetOptionToName[optionName] = displayName
        tradePetOptionToData[optionName] = petData
        table.insert(options, optionName)
    end

    if #options == 0 then
        table.insert(options, "No owned pets found - press Refresh Pet List")
    end

    print("[Trade Pets]: Found " .. tostring(#petList) .. " owned pet type(s).")

    return options
end

local function normalizeSelectedTradePetOptions(option)
    local normalized = {}
    local used = {}

    local function addOption(value)
        local optionText = tostring(value or "")

        if optionText ~= "" and tradePetOptionToData[optionText] and not used[optionText] then
            used[optionText] = true
            table.insert(normalized, optionText)
        end
    end

    if type(option) == "table" then
        for _, value in ipairs(option) do
            addOption(value)
        end

        if #normalized == 0 then
            for key, value in pairs(option) do
                if type(key) == "string" and value == true then
                    addOption(key)
                elseif type(value) == "string" then
                    addOption(value)
                end
            end
        end
    else
        addOption(option)
    end

    return normalized
end

