local function startAutoAccept()
    if autoAcceptLoopRunning then return end

    autoAcceptLoopRunning = true

    task.spawn(function()
        resetAutoAcceptTradeTimers()

        while autoAccept do
            if not tradeHelperEnabled then
                autoAccept = false
                notify("Auto Accept", "This will not work unless activate trade helper is on it's needed to check values", 4)
                break
            end

            local now = os.clock()
            local currentTradeSignature = getTradeWindowSignature()
            local tradeOpen = currentTradeSignature ~= "no_trade_gui"

            if not tradeOpen then
                resetAutoAcceptTradeTimers()
                task.wait(0.5)
                continue
            end

            if tradeOpen and not autoAcceptWasTradeOpen then
                autoAcceptWasTradeOpen = true
                autoAcceptWaitingForWinSince = now
                scheduleNextAutoAcceptQuickChat(now)
                autoAcceptDeclineSentForCurrentTrade = false
                autoAcceptAlreadyAcceptedCurrentWin = false
                autoAcceptLastTradeSignature = ""
                autoAcceptAcceptedTradeSignature = ""
                print("[Auto Accept] Trade detected. Waiting up to " .. tostring(AUTO_ACCEPT_DECLINE_AFTER_SECONDS) .. " seconds for WIN.")
            end

            local result = getTradeResult()

            if result == "WIN" then
                autoAcceptWaitingForWinSince = 0
                autoAcceptNextQuickChatAt = 0
                autoAcceptDeclineSentForCurrentTrade = false

                local tradeSignature = currentTradeSignature

                if tradeSignature ~= autoAcceptLastTradeSignature then
                    autoAcceptLastTradeSignature = tradeSignature
                    autoAcceptAlreadyAcceptedCurrentWin = false
                end

                if now - lastAutoAcceptAt >= AUTO_ACCEPT_RETRY_DELAY then
                    lastAutoAcceptAt = now

                    if acceptNegotiationOnce() then
                        autoAcceptAlreadyAcceptedCurrentWin = true
                        autoAcceptAcceptedTradeSignature = tradeSignature
                    end
                end
            else
                autoAcceptAlreadyAcceptedCurrentWin = false
                autoAcceptLastTradeSignature = ""
                autoAcceptAcceptedTradeSignature = ""

                if not autoAcceptDeclineSentForCurrentTrade then
                    if autoAcceptWaitingForWinSince <= 0 then
                        autoAcceptWaitingForWinSince = now
                        scheduleNextAutoAcceptQuickChat(now)
                    end

                    if autoAcceptNextQuickChatAt > 0 and now >= autoAcceptNextQuickChatAt then
                        sendAutoAcceptQuickChat()
                        scheduleNextAutoAcceptQuickChat(now)
                    end

                    if now - autoAcceptWaitingForWinSince >= AUTO_ACCEPT_DECLINE_AFTER_SECONDS then
                        autoAcceptDeclineSentForCurrentTrade = true
                        declineTradeOnce()
                        notify("Auto Accept", "No WIN detected after 90 seconds. Declined trade.", 4)
                    end
                end
            end

            task.wait(0.5)
        end

        resetAutoAcceptTradeTimers()
        autoAcceptLoopRunning = false
    end)
end

local function getIncomingTradeRequestPlayer()
    if getTradeWindowSignature() ~= "no_trade_gui" then
        return nil
    end

    local possiblePlayers = {}

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            table.insert(possiblePlayers, otherPlayer)
        end
    end

    local function scanTextForPlayer(text)
        local rawText = tostring(text or "")
        local lowerText = rawText:lower()

        if not lowerText:find("trade") and not lowerText:find("request") and not lowerText:find("accept") and not lowerText:find("decline") then
            return nil
        end

        for _, otherPlayer in ipairs(possiblePlayers) do
            local name = tostring(otherPlayer.Name or "")
            local displayName = tostring(otherPlayer.DisplayName or "")

            if name ~= "" and lowerText:find(name:lower(), 1, true) then
                return otherPlayer
            end

            if displayName ~= "" and lowerText:find(displayName:lower(), 1, true) then
                return otherPlayer
            end
        end

        return nil
    end

    for _, root in ipairs(getGuiSearchRoots()) do
        for _, guiObject in ipairs(root:GetDescendants()) do
            if isGuiObjectActuallyVisible(guiObject) and (guiObject:IsA("TextLabel") or guiObject:IsA("TextButton") or guiObject:IsA("TextBox")) then
                local foundPlayer = scanTextForPlayer(guiObject.Text)

                if foundPlayer then
                    return foundPlayer
                end
            end
        end
    end

    return nil
end

local function acceptIncomingTradeRequest(playerToAccept)
    if not playerToAccept then
        return false
    end

    local ok, result = callTradeApiRemote("TradeAPI/AcceptOrDeclineTradeRequest", playerToAccept, true)

    if ok then
        print("[Auto Accept Trade Requests] Accepted trade request from:", playerToAccept.Name, result)
    end

    return ok
end

local function startAutoAcceptTradeRequests()
    if autoAcceptTradeRequestsLoopRunning then return end

    autoAcceptTradeRequestsLoopRunning = true

    task.spawn(function()
        while autoAcceptTradeRequests do
            local partner = getIncomingTradeRequestPlayer()
            local now = os.clock()

            if partner then
                local playerName = tostring(partner.Name)

                if playerName ~= autoAcceptTradeRequestsLastPlayer or now - autoAcceptTradeRequestsLastAt >= AUTO_ACCEPT_TRADE_REQUEST_RETRY_DELAY then
                    autoAcceptTradeRequestsLastPlayer = playerName
                    autoAcceptTradeRequestsLastAt = now
                    autoAcceptTradeRequestsLastAttempts[playerName] = now
                    acceptIncomingTradeRequest(partner)
                end
            else
                autoAcceptTradeRequestsLastPlayer = ""

                -- Fallback: some trade request popups do not expose the requester's name in visible UI.
                -- The server only accepts if a real request from that player exists, so we safely try each player on a cooldown.
                for _, otherPlayer in ipairs(Players:GetPlayers()) do
                    if otherPlayer ~= player then
                        local playerName = tostring(otherPlayer.Name)
                        local lastAttempt = autoAcceptTradeRequestsLastAttempts[playerName] or 0

                        if now - lastAttempt >= AUTO_ACCEPT_TRADE_REQUEST_RETRY_DELAY then
                            autoAcceptTradeRequestsLastAttempts[playerName] = now
                            acceptIncomingTradeRequest(otherPlayer)
                        end
                    end
                end
            end

            task.wait(0.5)
        end

        autoAcceptTradeRequestsLastPlayer = ""
        autoAcceptTradeRequestsLastAt = 0
        autoAcceptTradeRequestsLastAttempts = {}
        autoAcceptTradeRequestsLoopRunning = false
    end)
end

