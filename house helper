local function findTradeAddRemote()
    local api = ReplicatedStorage:FindFirstChild("API")
    local candidateNames = {
        "TradeAPI/AddItemToOffer",
        "TradeAPI/AddItemToTrade",
        "TradeAPI/AddItem",
        "TradeAPI/OfferItem",
        "TradeAPI/AddPetToOffer",
        "TradeAPI/AddPetToTrade",
        "AddItemToOffer",
        "AddItemToTrade",
        "AddPetToOffer",
        "AddPetToTrade"
    }

    if api then
        for _, name in ipairs(candidateNames) do
            local remote = api:FindFirstChild(name)

            if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
                return remote
            end
        end
    end

    local wanted = {}

    for _, name in ipairs(candidateNames) do
        wanted[name] = true
    end

    for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
        if (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) and wanted[remote.Name] then
            return remote
        end
    end

    return nil
end

local function isTradeWindowOpen()
    local playerGui = player:FindFirstChildOfClass("PlayerGui")

    if not playerGui then
        return false
    end

    local tradeApps = {
        "TradeApp",
        "TradePreviewApp"
    }

    for _, appName in ipairs(tradeApps) do
        local app = playerGui:FindFirstChild(appName)

        if app then
            if app:IsA("LayerCollector") and app.Enabled == false then
                continue
            end

            if app:IsA("GuiObject") and isGuiObjectActuallyVisible(app) then
                return true
            end

            for _, descendant in ipairs(app:GetDescendants()) do
                if descendant:IsA("GuiObject") and isGuiObjectActuallyVisible(descendant) then
                    return true
                end
            end
        end
    end

    return false
end

local function addSelectedPetsToTradeOnce()
    local selectedUniqueIds = getSelectedTradePetUniqueIds()

    if #selectedUniqueIds == 0 then
        notify("Trade Pets", "No selected pets to add.", 3)
        return false
    end

    local remote = findTradeAddRemote()

    if not remote then
        notify("Trade Pets", "Trade add remote not found.", 4)
        warn("[Trade Pets]: Could not find TradeAPI/AddItemToOffer remote.")
        return false
    end

    local added = 0

    for _, uniqueId in ipairs(selectedUniqueIds) do
        local ok, err = pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(uniqueId)
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(uniqueId)
            end
        end)

        if ok then
            added += 1
            print("[Trade Pets]: Added selected pet ID to offer:", uniqueId)
        else
            warn("[Trade Pets]: Failed to add pet ID:", uniqueId, err)
        end

        task.wait(0.25)
    end

    notify("Trade Pets", "Auto-added " .. tostring(added) .. " selected pet(s). Not confirming.", 4)
    return added > 0
end

local function startAutoAddSelectedPets()
    if autoAddSelectedPetsLoopRunning then
        return
    end

    autoAddSelectedPetsLoopRunning = true

    task.spawn(function()
        local wasTradeOpen = false

        while autoAddSelectedPets do
            local tradeOpen = isTradeWindowOpen()

            if tradeOpen and not wasTradeOpen then
                task.wait(1)
                addSelectedPetsToTradeOnce()
            end

            wasTradeOpen = tradeOpen
            task.wait(0.5)
        end

        autoAddSelectedPetsLoopRunning = false
    end)
end

