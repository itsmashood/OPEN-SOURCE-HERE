local function isTextOnTheirTradeSide(textObject, root)
    local objectCenterX = getGuiObjectCenterX(textObject)
    local rootCenterX = getGuiRootCenterX(root)

    if not objectCenterX or not rootCenterX then
        return false
    end

    return objectCenterX >= rootCenterX
end

local function getTheirSideHouseTradeValue()
    local strongHighest = nil
    local fallbackHighest = nil
    local positionalHighest = nil

    for _, root in ipairs(getHouseTradeGuiRoots()) do
        for _, descendant in ipairs(root:GetDescendants()) do
            if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
                if isGuiObjectActuallyVisible(descendant) then
                    local text = cleanHouseValueText(descendant.Text)
                    local path = descendant:GetFullName()

                    if houseTextLooksLikeTheirSide(text, path, false) then
                        local ancestor = descendant

                        for _ = 1, 4 do
                            if ancestor and ancestor.Parent then
                                ancestor = ancestor.Parent
                            end
                        end

                        local containerValue = highestHouseValueInContainer(ancestor)

                        if containerValue and (not strongHighest or containerValue > strongHighest) then
                            strongHighest = containerValue
                        end
                    end

                    if houseTextLooksLikeValue(text, path) then
                        local value = parseHouseValueNumber(text)

                        if value then
                            if houseTextLooksLikeTheirSide(text, path, false) then
                                if not strongHighest or value > strongHighest then
                                    strongHighest = value
                                end
                            elseif houseTextLooksLikeTheirSide(text, path, true) then
                                if not fallbackHighest or value > fallbackHighest then
                                    fallbackHighest = value
                                end
                            end
                        end
                    end

                    if not houseTextLooksLikeMySide(text, path) then
                        local canUsePlainNumber = houseTextLooksLikeValue(text, path) or housePlainNumberCouldBeValue(text, path)

                        if canUsePlainNumber and isTextOnTheirTradeSide(descendant, root) then
                            local value = parseHouseValueNumber(text)

                            if value and (not positionalHighest or value > positionalHighest) then
                                positionalHighest = value
                            end
                        end
                    end
                end
            end
        end
    end

    local result = strongHighest or fallbackHighest or positionalHighest

    if result then
        print("[House Value Check] Their side value detected:", result)
    else
        print("[House Value Check] No their-side value detected yet.")
    end

    return result
end
