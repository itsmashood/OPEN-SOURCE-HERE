local function getSelectedTradePetUniqueIds()
    local selectedUniqueIds = {}
    local selectedPetItems = {}
    local quantityPerPet = tonumber(selectedTradePetQuantity) or 1

    if quantityPerPet < 1 then
        quantityPerPet = 1
    end

    if quantityPerPet > MAX_TRADE_ITEMS_TO_ADD then
        quantityPerPet = MAX_TRADE_ITEMS_TO_ADD
    end

    for _, data in ipairs(getCurrentSelectedTradePetDataList()) do
        local ids = data.ids or {}
        local chosenForThisPet = {}
        local maxForThisPet = quantityPerPet

        if maxForThisPet > #ids then
            maxForThisPet = #ids
        end

        for i = 1, maxForThisPet do
            if ids[i] and #selectedUniqueIds < MAX_TRADE_ITEMS_TO_ADD then
                table.insert(selectedUniqueIds, ids[i])
                table.insert(chosenForThisPet, ids[i])
            end
        end

        table.insert(selectedPetItems, {
            PetName = data.name or "",
            DisplayName = (data.displayName or data.name or "") .. " x" .. tostring(data.count or 0),
            Variant = data.variantLabel or "Normal",
            VariantKey = data.variantKey or "normal",
            IsMega = data.isMega == true,
            IsNeon = data.isNeon == true,
            IsFly = data.isFly == true,
            IsRide = data.isRide == true,
            Kind = data.kind or "",
            Rarity = data.rarity or "",
            Quantity = #chosenForThisPet,
            MaxQuantity = tonumber(data.count) or #ids,
            UniqueIds = ids,
            SelectedUniqueIds = chosenForThisPet
        })

        if #selectedUniqueIds >= MAX_TRADE_ITEMS_TO_ADD then
            break
        end
    end

    return selectedUniqueIds, selectedPetItems
end

