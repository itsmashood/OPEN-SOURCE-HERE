local function resetAutoAcceptTradeTimers()
    autoAcceptWaitingForWinSince = 0
    autoAcceptNextQuickChatAt = 0
    autoAcceptDeclineSentForCurrentTrade = false
    autoAcceptWasTradeOpen = false
    autoAcceptAlreadyAcceptedCurrentWin = false
    autoAcceptLastTradeSignature = ""
    autoAcceptAcceptedTradeSignature = ""
end

