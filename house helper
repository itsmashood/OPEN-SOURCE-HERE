local function startAutoConfirm()
    if autoConfirmLoopRunning then return end

    autoConfirmLoopRunning = true

    task.spawn(function()
        while autoConfirm do
            if not tradeHelperEnabled then
                autoConfirm = false
                notify("Auto Confirm", "This will not work unless activate trade helper is on it's needed to check values", 4)
                break
            end

            local currentTradeSignature = getTradeWindowSignature()
            local tradeOpen = currentTradeSignature ~= "no_trade_gui"

            if not tradeOpen then
                autoConfirmLastTradeSignature = ""
                autoConfirmLastAttemptAt = 0
                autoConfirmInProgress = false
                task.wait(0.5)
                continue
            end

            local result = getTradeResult()
            local now = os.clock()

            if result == "WIN" and not autoConfirmInProgress then
                if currentTradeSignature ~= autoConfirmLastTradeSignature or now - autoConfirmLastAttemptAt >= AUTO_CONFIRM_RETRY_DELAY then
                    autoConfirmLastTradeSignature = currentTradeSignature
                    autoConfirmLastAttemptAt = now
                    autoConfirmInProgress = true

                    task.spawn(function()
                        for attempt = 1, 3 do
                            if not autoConfirm or not tradeHelperEnabled then
                                break
                            end

                            if getTradeResult() ~= "WIN" then
                                warn("[Auto Confirm] Confirm stopped because trade is no longer WIN.")
                                break
                            end

                            confirmTradeOnce(attempt)

                            if attempt < 3 then
                                task.wait(1)
                            end
                        end

                        autoConfirmInProgress = false
                    end)
                end
            elseif result ~= "WIN" then
                autoConfirmLastTradeSignature = ""
            end

            task.wait(0.5)
        end

        autoConfirmInProgress = false
        autoConfirmLastTradeSignature = ""
        autoConfirmLastAttemptAt = 0
        autoConfirmLoopRunning = false
    end)
end


local function parseHouseValueNumber(text)
    local clean = tostring(text or ""):lower()
    clean = clean:gsub("<[^>]->", "")
    clean = clean:gsub(",", "")
    clean = clean:gsub("%s+", "")

    local bestValue = nil

    for numberText, suffix in clean:gmatch("(%d+%.?%d*)([kmb]?)") do
        local value = tonumber(numberText)

        if value then
            if suffix == "k" then
                value *= 1000
            elseif suffix == "m" then
                value *= 1000000
            elseif suffix == "b" then
                value *= 1000000000
            end

            if not bestValue or value > bestValue then
                bestValue = value
            end
        end
    end

    return bestValue
end

local function cleanHouseValueText(text)
    return tostring(text or "")
        :gsub("<[^>]->", "")
        :gsub("\n", " ")
        :gsub("%s+", " ")
end

local function houseTextLooksLikeValue(text, path)
    local joined = (cleanHouseValueText(text) .. " " .. tostring(path or "")):lower()

    if joined:find("seconds", 1, true) or joined:find("cooldown", 1, true) or joined:find("preset", 1, true) then
        return false
    end

    if joined:find("value", 1, true) or joined:find("amv", 1, true) or joined:find("total", 1, true) or joined:find("$", 1, true) then
        return parseHouseValueNumber(joined) ~= nil
    end

    return false
end

local function houseTextLooksLikeMySide(text, path)
    local joined = (cleanHouseValueText(text) .. " " .. tostring(path or "")):lower()
    local localName = tostring(player.Name or ""):lower()
    local localDisplayName = tostring(player.DisplayName or ""):lower()

    if joined:find("your", 1, true) or joined:find("yours", 1, true) or joined:find("my", 1, true) or joined:find("mine", 1, true) or joined:find("you", 1, true) then
        return true
    end

    if localName ~= "" and joined:find(localName, 1, true) then
        return true
    end

    if localDisplayName ~= "" and localDisplayName ~= localName and joined:find(localDisplayName, 1, true) then
        return true
    end

    return false
end

local function houseTextLooksLikeTheirSide(text, path, allowRightFallback)
    local joined = (cleanHouseValueText(text) .. " " .. tostring(path or "")):lower()

    if houseTextLooksLikeMySide(text, path) then
        return false
    end

    local strongWords = {
        "their",
        "theirs",
        "them",
        "other",
        "partner",
        "opponent"
    }

    for _, word in ipairs(strongWords) do
        if joined:find(word, 1, true) then
            return true
        end
    end

    if allowRightFallback then
        local fallbackWords = {
            "right",
            "offer2",
            "offer_2",
            "receiver",
            "target"
        }

        for _, word in ipairs(fallbackWords) do
            if joined:find(word, 1, true) then
                return true
            end
        end
    end

    return false
end

local function getHouseTradeGuiRoots()
    local roots = {}
    local seen = {}

    local function addRoot(root)
        if root and not seen[root] then
            seen[root] = true
            table.insert(roots, root)
        end
    end

    for _, searchRoot in ipairs(getGuiSearchRoots()) do
        for _, child in ipairs(searchRoot:GetChildren()) do
            local childName = tostring(child.Name or ""):lower()

            if childName:find("trade", 1, true) or childName:find("tbi", 1, true) or childName:find("helper", 1, true) or childName:find("amv", 1, true) then
                addRoot(child)
            end
        end
    end

    return roots
end

local function highestHouseValueInContainer(container)
    local highest = nil

    if not container then
        return nil
    end

    for _, descendant in ipairs(container:GetDescendants()) do
        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
            if isGuiObjectActuallyVisible(descendant) then
                local text = cleanHouseValueText(descendant.Text)
                local path = descendant:GetFullName()

                if not houseTextLooksLikeMySide(text, path) and houseTextLooksLikeValue(text, path) then
                    local value = parseHouseValueNumber(text)

                    if value and (not highest or value > highest) then
                        highest = value
                    end
                end
            end
        end
    end

    return highest
end

local function housePlainNumberCouldBeValue(text, path)
