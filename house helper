    end

    updateTradePetSelectionExport()

    if #selectedTradePetOptions > 0 then
        print("[Trade Pets]: Selected " .. tostring(#selectedTradePetOptions) .. " pet type(s), quantity each: " .. tostring(selectedTradePetQuantity))
