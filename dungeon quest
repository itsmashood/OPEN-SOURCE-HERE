    if not old then
        return
    end

    old.Alive = false

    for _, connection in ipairs(
        old.Connections or {}
    ) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    if old.RenderName then
        pcall(function()
            RunService:UnbindFromRenderStep(
                old.RenderName
            )
        end)
    end

    if old.Interface then
        pcall(function()
            old.Interface:Destroy()
