local function createInterface()
    local success, interfaceError =
        pcall(function()
            local compile, compileError =
                loadstring(
                    XYNERIA_UI_SOURCE
                )

            if not compile then
                error(compileError)
            end

            local XyneriaUI = compile()

            if not XyneriaUI then
                error(
                    "Standalone XyneriaUI returned no library"
                )
            end

            local app =
                XyneriaUI:CreateWindow({
                    Title = "DUNGEON QUEST",
                    Author = "XYNERIA",
                    Version = "V7.2",
                    Live = true,
                    StatusTitle = "COMBAT PILOT",
                    Size = UDim2.fromOffset(
                        680,
                        455
                    ),
                    MinSize = Vector2.new(
                        520,
                        340
                    )
                })

            if not app then
                error(
                    "Xyneria window was not created"
                )
            end

            State.Interface = app

            local combatTab =
                app:Tab({
                    Title = "Combat",
                    Icon = "swords"
                })

            combatTab:Toggle({
                Title = "Combat Pilot",
                Desc = "Movement, targeting and smart dodging",
                Value = ENABLED,
                Flag = "DQCombatPilot",
                Callback = function(value)
                    ENABLED = value

                    if not value then
                        DesiredDirection =
                            Vector3.zero
                    end
                end
            })

            combatTab:Toggle({
                Title = "Auto Q",
                Desc = "Cast Inner Focus once per mob pack",
                Value = AUTO_Q,
                Flag = "DQAutoQ",
                Callback = function(value)
                    AUTO_Q = value
                end
            })

            combatTab:Toggle({
                Title = "Auto E",
                Desc = "Cast Geyser once per mob pack",
                Value = AUTO_E,
                Flag = "DQAutoE",
                Callback = function(value)
                    AUTO_E = value
                end
            })

            combatTab:Paragraph({
                Title = "Mob spacing",
                Desc = "Retreats inside 14 studs and releases at 17 studs."
            })

            local automationTab =
                app:Tab({
                    Title = "Automation",
                    Icon = "repeat"
                })

            automationTab:Paragraph({
                Title = "Dungeon flow",
                Desc = "Replay and Back to Lobby are mutually exclusive."
            })

            automationTab:Toggle({
                Title = "Auto Start",
                Desc = "Press Start when the dungeon start button appears",
                Value = AUTO_START,
                Flag = "DQAutoStart",
                Callback = function(value)
                    AUTO_START = value
                end
            })

            local replayToggle = nil
            local lobbyToggle = nil

            replayToggle =
                automationTab:Toggle({
                    Title = "Auto Replay",
                    Desc = "Use the curly-arrow button after completion",
                    Value = AUTO_REPLAY,
                    Flag = "DQAutoReplay",
                    Callback = function(value)
                        AUTO_REPLAY = value

                        if value then
                            AUTO_LOBBY = false

                            if lobbyToggle then
                                lobbyToggle:Set(
                                    false,
                                    true
                                )
                            end
                        end
                    end
                })

            lobbyToggle =
                automationTab:Toggle({
                    Title = "Auto Back to Lobby",
                    Desc = "Use the door button after completion",
                    Value = AUTO_LOBBY,
                    Flag = "DQAutoLobby",
                    Callback = function(value)
                        AUTO_LOBBY = value

                        if value then
                            AUTO_REPLAY = false

                            if replayToggle then
                                replayToggle:Set(
                                    false,
                                    true
                                )
                            end
                        end
                    end
                })

            local statusTab =
                app:Tab({
                    Title = "Status",
                    Icon = "activity"
                })

            local statusCode =
                statusTab:Code({
                    Content = "Combat Pilot is starting..."
                })

            local settingsTab =
                app:Tab({
                    Title = "Settings",
                    Icon = "settings"
                })

            settingsTab:Button({
                Title = "Save configuration",
                Callback = function()
                    local ok =
                        app:SaveConfig(
                            "dungeon_quest"
                        )

                    app:Notify(
                        "Configuration",
                        ok
                            and "Saved."
                            or "Could not save.",
                        ok and "check" or "x",
                        2
                    )
                end
            })

            settingsTab:Button({
                Title = "Load configuration",
                Callback = function()
                    local ok =
                        app:LoadConfig(
                            "dungeon_quest"
                        )

                    app:Notify(
                        "Configuration",
                        ok
                            and "Loaded."
                            or "Could not load.",
                        ok and "check" or "x",
                        2
                    )
                end
            })

            local statusElapsed = 0

            connect(
                RunService.Heartbeat,
                function(dt)
                    statusElapsed =
                        statusElapsed + dt

                    if statusElapsed < 0.10 then
                        return
                    end

                    statusElapsed = 0

                    local hazardCount = 0
                    local expandingCount = 0

                    for _, hazard in pairs(
                        Hazards
                    ) do
                        hazardCount =
                            hazardCount + 1

                        if hazard.Expanding then
                            expandingCount =
                                expandingCount + 1
                        end
                    end

                    local targetName =
                        Target
                        and Target.Name
                        or "NONE"

                    local distanceText =
                        TargetDistance < math.huge
                        and string.format(
                            "%.1f",
                            TargetDistance
                        )
                        or "-"

                    local content =
                        "Mode: "
                        .. Mode
                        .. "\nTarget: "
                        .. targetName
                        .. "\nDistance: "
                        .. distanceText
                        .. "\nThreat: "
                        .. ThreatLevel
                        .. " / "
                        .. ThreatKind
                        .. "\nDodge side: "
                        .. DodgeSide
                        .. " | Expand:"
                        .. expandingCount
                        .. "\nSpells: "
                        .. SpellFlow:Status()
                        .. "\nProfile: "
                        .. DungeonData.Name
                        .. "\nHazards: "
                        .. hazardCount
                        .. "\nAuto Start:"
                        .. (
                            AUTO_START
                            and "ON"
                            or "OFF"
                        )
                        .. " Replay:"
                        .. (
                            AUTO_REPLAY
                            and "ON"
                            or "OFF"
                        )
                        .. " Lobby:"
                        .. (
                            AUTO_LOBBY
                            and "ON"
                            or "OFF"
                        )

                    statusCode:Set(content)
                end
            )

            app:Notify(
                "Combat Pilot V7.2",
                "Standalone Xyneria UI loaded.",
                "check",
                2
            )
        end)

    if not success then
        if warn then
            warn(
                "Combat Pilot Xyneria UI error: "
                .. tostring(interfaceError)
            )
        end
    end
end

createInterface()

print(
    "Dungeon Quest Combat Pilot V7.2 loaded"
)
