            if hazard.Expanding then
                expanding =
                    expanding + 1
            end

            if hazard.Kind
                == "LASER" then

                lasers =
                    lasers + 1

            elseif hazard.Kind
                == "PROJECTILE" then

                projectiles =
                    projectiles + 1
            end
        end

        for enemy in pairs(
            Enemies
        ) do
            if validEnemy(enemy) then
                enemies =
                    enemies + 1
            end
        end

        local current =
            ThreatCurrent
                ~= math.huge
            and string.format(
                "%.1f",
                ThreatCurrent
            )
            or "-"

        local future =
            ThreatFuture
                ~= math.huge
            and string.format(
                "%.1f",
                ThreatFuture
            )
            or "-"

        local statusText =
            "Mode: "
            .. Mode

            .. "\nTarget: "
            .. (
                Target
                and Target.Name
                or "NONE"
            )

            .. "\nDistance: "
            .. (
                TargetDistance
                    ~= math.huge
                and string.format(
                    "%.1f",
                    TargetDistance
                )
                or "-"
            )

            .. "\nFacing: "
            .. (
                FacingOkay
                and "YES"
                or "TURNING"
            )

            .. "\nThreat: "
            .. ThreatLevel
            .. " / "
            .. ThreatKind

            .. "\nDanger now/future: "
            .. current
            .. " / "
            .. future

            .. "\nDodge side: "
            .. DodgeSide
            .. " | Expand:"
            .. expanding

            .. "\nHazards: "
            .. hazards
            .. " | Lasers:"
            .. lasers
            .. " | Proj:"
            .. projectiles

            .. "\nEnemies: "
            .. enemies
            .. " | Room:"
            .. tostring(
                LastRoomOrder
            )

            .. "\nPath: "
            .. (
                Waypoints
                and "YES"
                or "NO"
            )

            .. " | Stuck:"
            .. tostring(
                StuckCount
            )

        status.Text = statusText

        if XyneriaStatus then
            pcall(function()
                XyneriaStatus:Set(
                    statusText
                )
            end)
        end
    end
)

refreshButtons()

end

createInterface()

print(
    "Dungeon Quest Combat Pilot V7.2 loaded"
)
