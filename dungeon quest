local LastQ = 0
local LastE = 0

local KeyBusy = {}

local function pressKey(
    key,
    fallback
)
    if KeyBusy[key] then
        return
    end

    KeyBusy[key] = true

    task.spawn(function()
        local success =
            pcall(function()
                VirtualInputManager:
                    SendKeyEvent(
                        true,
                        key,
                        false,
                        game
                    )

                task.wait(0.035)

                VirtualInputManager:
                    SendKeyEvent(
                        false,
                        key,
                        false,
                        game
                    )
            end)

        if not success
            and keypress
            and keyrelease then

            pcall(function()
                keypress(fallback)
                task.wait(0.035)
                keyrelease(fallback)
            end)
        end

        KeyBusy[key] = nil
    end)
end

local function useAbilities(
    target,
    distance,
    facing,
    mode
)
    if not validEnemy(target)
        or not facing
        or distance > ABILITY_RANGE
        or mode == "DODGE" then

        return
    end

    local now = os.clock()

    if AUTO_Q
        and now - LastQ
            >= Q_INTERVAL then

        LastQ = now

        pressKey(
            Enum.KeyCode.Q,
            0x51
        )
    end

    if AUTO_E
        and now - LastE
            >= E_INTERVAL then

        LastE = now

        pressKey(
            Enum.KeyCode.E,
            0x45
        )
    end
end

