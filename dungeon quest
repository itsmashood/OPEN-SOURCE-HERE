local function discoverNewHazardPart(part)
    local kind =
        classifyPart(
            part,
            true
        )

    if kind then
        registerHazardPart(
            part,
            kind
        )

        return
    end

    task.spawn(function()
        for _ = 1, 7 do
            task.wait(0.03)

            if not State.Alive
                or not part.Parent
                or Hazards[part] then

                return
            end

            local delayedKind =
                classifyPart(
                    part,
                    true
                )

            if delayedKind then
                registerHazardPart(
                    part,
                    delayedKind
                )

                return
            end
        end
    end)
end

