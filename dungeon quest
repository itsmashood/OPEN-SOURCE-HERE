local lastStatusUpdate = 0

connect(
    RunService.RenderStepped,
    function()
        local now = os.clock()

        if now - lastStatusUpdate < 0.10 then
            return
        end

        lastStatusUpdate = now

        local hazards = 0
        local lasers = 0
        local projectiles = 0
        local enemies = 0

        for _, hazard in pairs(
            Hazards
        ) do
            hazards =
                hazards + 1

            if hazard.Kind
                == "LASER" then

                lasers =
                    lasers + 1

            elseif hazard.Kind
                == "PROJECTILE" then

                projectiles =
                    projectiles + 1
            end
        end

        for enemy in pairs(
            Enemies
        ) do
            if validEnemy(enemy) then
                enemies =
                    enemies + 1
            end
        end

        local current =
            ThreatCurrent
                ~= math.huge
            and string.format(
                "%.1f",
                ThreatCurrent
            )
            or "-"

        local future =
            ThreatFuture
                ~= math.huge
            and string.format(
                "%.1f",
                ThreatFuture
            )
            or "-"

        status.Text =
            "Mode: "
            .. Mode

            .. "\nTarget: "
            .. (
                Target
                and Target.Name
                or "NONE"
            )

            .. "\nDistance: "
            .. (
                TargetDistance
                    ~= math.huge
                and string.format(
                    "%.1f",
                    TargetDistance
                )
                or "-"
            )

            .. "\nFacing: "
            .. (
                FacingOkay
                and "YES"
                or "TURNING"
            )

            .. "\nThreat: "
            .. ThreatLevel
            .. " / "
            .. ThreatKind

            .. "\nDanger now/future: "
            .. current
            .. " / "
            .. future

            .. "\nHazards: "
            .. hazards
            .. " | Lasers:"
            .. lasers
            .. " | Proj:"
            .. projectiles

            .. "\nEnemies: "
            .. enemies
            .. " | Room:"
            .. tostring(
                LastRoomOrder
            )

            .. "\nPath: "
            .. (
                Waypoints
                and "YES"
                or "NO"
            )

            .. " | Stuck:"
            .. tostring(
                StuckCount
            )
    end
)

