local function isOwnAbility(object)
    local current = object

    for _ = 1, 7 do
        if not current then
            break
        end

        local name =
            string.lower(
                current.Name
            )

        if name:find(
            "geyser",
            1,
            true
        )
            or name:find(
                "innerfocus",
                1,
                true
            )
            or name:find(
                "inner focus",
                1,
                true
            ) then

            return true
        end

        current = current.Parent
    end

    return false
end

