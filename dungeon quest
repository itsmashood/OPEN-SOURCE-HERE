            if FacingAlign then
                FacingAlign.Enabled =
                    false
            end

            return
        end

        humanoid.WalkSpeed =
            math.clamp(
                DesiredSpeed,
                0,
                MAX_SPEED
            )

        humanoid.AutoRotate = false

        humanoid:Move(
            DesiredDirection,
            false
        )

        --------------------------------------------------
        -- ALWAYS FACE ENEMY
        --------------------------------------------------

        FacingOkay =
            faceTarget(
                root,
                Target
            )

        --------------------------------------------------
        -- STILL ATTACK WHILE EVADE
        --------------------------------------------------

        SpellFlow:Use(
            Target,
            TargetDistance,
            FacingOkay,
            Mode,
            RemoteCastMode
        )
    end
)

